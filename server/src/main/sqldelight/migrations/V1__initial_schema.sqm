-- Initial schema for the Muixeranga d'Elx data model (data-model.json 0.1.0-draft).
--
-- Storage conventions:
--   ids       TEXT, generated by the backend (position_types use readable slugs)
--   datetime  TEXT, ISO 8601 UTC ("2026-08-15T18:00:00.000Z")
--   date      TEXT, "YYYY-MM-DD"
--   money     INTEGER, euro cents
--   boolean   INTEGER, 0 / 1
--   file      TEXT, path relative to FILES_DIR (the API exposes it as an absolute URI)
--   geopoint  two REAL columns, both set or both NULL
--   nested objects are flattened into prefixed columns; arrays live in child tables
--
-- Derived fields (isMinor, User.areas, User.positions, Event.contractId, Event.documentIds,
-- Event.attendanceSummary, InventoryItem.totalQuantity/lowStock, Group.*Ids, Figure.positions)
-- are computed by the backend and have no column.
--
-- Foreign keys are only enforced when each connection runs PRAGMA foreign_keys = ON.

CREATE TABLE groups (
    id                 TEXT    NOT NULL PRIMARY KEY,
    name               TEXT    NOT NULL,
    subtitle           TEXT,
    contact            TEXT,
    foundation         INTEGER,
    history            TEXT,
    image              TEXT,
    logo               TEXT,
    location_latitude  REAL,
    location_longitude REAL,
    faixa              TEXT    NOT NULL DEFAULT '[]' CHECK (json_valid(faixa) AND json_type(faixa) = 'array'),
    shirt              TEXT    NOT NULL DEFAULT '[]' CHECK (json_valid(shirt) AND json_type(shirt) = 'array'),
    trousers           TEXT    NOT NULL DEFAULT '[]' CHECK (json_valid(trousers) AND json_type(trousers) = 'array'),
    is_own             INTEGER NOT NULL DEFAULT 0 CHECK (is_own IN (0, 1)),
    website            TEXT,
    social_instagram   TEXT,
    social_facebook    TEXT,
    social_x           TEXT,
    social_youtube     TEXT,
    created_at         TEXT    NOT NULL,
    updated_at         TEXT    NOT NULL,
    CHECK ((location_latitude IS NULL) = (location_longitude IS NULL))
);

CREATE UNIQUE INDEX groups_single_own ON groups (is_own) WHERE is_own = 1;

CREATE TABLE users (
    id                             TEXT    NOT NULL PRIMARY KEY,
    name                           TEXT    NOT NULL CHECK (length(name) <= 80),
    last_names                     TEXT    CHECK (length(last_names) <= 120),
    nickname                       TEXT    CHECK (length(nickname) <= 60),
    birth_date                     TEXT,
    document_id                    TEXT    CHECK (length(document_id) <= 20),
    email                          TEXT    CHECK (email = lower(email)),
    phone_number                   TEXT,
    address_street                 TEXT,
    address_postal_code            TEXT,
    address_city                   TEXT,
    address_province               TEXT,
    about_me                       TEXT    CHECK (length(about_me) <= 2000),
    avatar                         TEXT,
    status                         TEXT    NOT NULL CHECK (status IN ('active', 'inactive', 'on_leave', 'former')),
    membership_type                TEXT    CHECK (membership_type IN ('member', 'collaborator', 'honorary')),
    member_number                  INTEGER UNIQUE,
    joined_at                      TEXT,
    left_at                        TEXT,
    board_role                     TEXT    CHECK (board_role IN ('president', 'vice_president', 'secretary', 'treasurer', 'vice_treasurer', 'vocal')),
    board_role_since               TEXT,
    group_id                       TEXT    REFERENCES groups (id) ON DELETE SET NULL,
    height_cm                      INTEGER CHECK (height_cm > 0),
    size_shirt                     TEXT    CHECK (size_shirt IN ('xs', 's', 'm', 'l', 'xl', 'xxl', 'xxxl', 'kids_4', 'kids_6', 'kids_8', 'kids_10', 'kids_12', 'kids_14')),
    size_trousers                  TEXT,
    emergency_contact_name         TEXT,
    emergency_contact_relationship TEXT    CHECK (emergency_contact_relationship IN ('mother', 'father', 'legal_guardian', 'partner', 'sibling', 'grandparent', 'friend', 'other')),
    emergency_contact_phone        TEXT,
    consent_data_processing        INTEGER NOT NULL DEFAULT 0 CHECK (consent_data_processing IN (0, 1)),
    consent_public_profile         INTEGER NOT NULL DEFAULT 0 CHECK (consent_public_profile IN (0, 1)),
    consent_image_rights           INTEGER NOT NULL DEFAULT 0 CHECK (consent_image_rights IN (0, 1)),
    consent_whatsapp               INTEGER NOT NULL DEFAULT 0 CHECK (consent_whatsapp IN (0, 1)),
    consent_signed_at              TEXT,
    consent_signed_by              TEXT,
    notes                          TEXT,
    created_at                     TEXT    NOT NULL,
    updated_at                     TEXT    NOT NULL
);

CREATE INDEX users_name ON users (name);
CREATE INDEX users_group_id ON users (group_id);

-- User.account: a row exists only for people with app access. No passwords (Firebase Authentication).
CREATE TABLE user_accounts (
    user_id       TEXT NOT NULL PRIMARY KEY REFERENCES users (id) ON DELETE CASCADE,
    role          TEXT NOT NULL CHECK (role IN ('member', 'technical', 'board', 'admin')),
    auth_provider TEXT NOT NULL DEFAULT 'firebase' CHECK (auth_provider IN ('firebase')),
    auth_uid      TEXT UNIQUE,
    login_email   TEXT NOT NULL UNIQUE CHECK (login_email = lower(login_email)),
    status        TEXT NOT NULL CHECK (status IN ('invited', 'active', 'disabled')),
    invited_at    TEXT,
    last_login_at TEXT,
    CHECK (status = 'invited' OR auth_uid IS NOT NULL)
);

-- User.guardians
CREATE TABLE user_guardians (
    id               INTEGER NOT NULL PRIMARY KEY,
    user_id          TEXT    NOT NULL REFERENCES users (id) ON DELETE CASCADE,
    name             TEXT    NOT NULL,
    relationship     TEXT    CHECK (relationship IN ('mother', 'father', 'legal_guardian', 'partner', 'sibling', 'grandparent', 'friend', 'other')),
    phone            TEXT,
    email            TEXT    CHECK (email = lower(email)),
    guardian_user_id TEXT    REFERENCES users (id) ON DELETE SET NULL,
    CHECK (guardian_user_id IS NULL OR guardian_user_id <> user_id)
);

CREATE INDEX user_guardians_user_id ON user_guardians (user_id);
CREATE INDEX user_guardians_guardian_user_id ON user_guardians (guardian_user_id);

CREATE TABLE areas (
    id                TEXT    NOT NULL PRIMARY KEY,
    name              TEXT    NOT NULL CHECK (length(name) <= 120),
    slug              TEXT    UNIQUE CHECK (length(slug) <= 60),
    description       TEXT,
    status            TEXT    NOT NULL CHECK (status IN ('active', 'developing', 'inactive')),
    whatsapp_group    TEXT    CHECK (length(whatsapp_group) <= 120),
    meeting_frequency TEXT    CHECK (meeting_frequency IN ('weekly', 'biweekly', 'monthly', 'as_needed')),
    goals             TEXT,
    sort_order        INTEGER,
    color             TEXT    CHECK (color GLOB '#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'),
    notes             TEXT,
    created_at        TEXT    NOT NULL,
    updated_at        TEXT    NOT NULL
);

CREATE INDEX areas_sort_order ON areas (sort_order);

-- Area.leadIds (role = 'lead') and Area.memberIds (role = 'member').
CREATE TABLE area_members (
    area_id TEXT NOT NULL REFERENCES areas (id) ON DELETE CASCADE,
    user_id TEXT NOT NULL REFERENCES users (id) ON DELETE CASCADE,
    role    TEXT NOT NULL CHECK (role IN ('lead', 'member')),
    PRIMARY KEY (area_id, user_id)
);

CREATE INDEX area_members_user_id ON area_members (user_id);

CREATE TABLE figures (
    id                 TEXT    NOT NULL PRIMARY KEY,
    name               TEXT    NOT NULL,
    description        TEXT,
    levels             INTEGER CHECK (levels BETWEEN 1 AND 8),
    people_required    INTEGER CHECK (people_required >= 0),
    difficulty         INTEGER CHECK (difficulty BETWEEN 1 AND 5),
    status             TEXT    CHECK (status IN ('learning', 'consolidated', 'retired')),
    first_performed_at TEXT,
    image              TEXT,
    video_url          TEXT,
    created_at         TEXT    NOT NULL,
    updated_at         TEXT    NOT NULL
);

CREATE INDEX figures_name ON figures (name);

CREATE TABLE position_types (
    id         TEXT NOT NULL PRIMARY KEY,
    name       TEXT NOT NULL UNIQUE CHECK (length(name) <= 60),
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

-- A person appears at most once per figure; unassigned positions (user_id NULL) are not limited.
CREATE TABLE positions (
    id               TEXT    NOT NULL PRIMARY KEY,
    figure_id        TEXT    NOT NULL REFERENCES figures (id) ON DELETE CASCADE,
    position_type_id TEXT    NOT NULL REFERENCES position_types (id) ON DELETE RESTRICT,
    user_id          TEXT    REFERENCES users (id) ON DELETE SET NULL,
    x                INTEGER NOT NULL,
    y                INTEGER NOT NULL,
    z                INTEGER NOT NULL,
    created_at       TEXT    NOT NULL,
    updated_at       TEXT    NOT NULL,
    UNIQUE (figure_id, user_id)
);

CREATE INDEX positions_figure_id_z ON positions (figure_id, z);
CREATE INDEX positions_position_type_id ON positions (position_type_id);
CREATE INDEX positions_user_id ON positions (user_id);

CREATE TABLE events (
    id                 TEXT    NOT NULL PRIMARY KEY,
    name               TEXT    NOT NULL CHECK (length(name) <= 200),
    date               TEXT    NOT NULL,
    end_date           TEXT,
    all_day            INTEGER NOT NULL DEFAULT 0 CHECK (all_day IN (0, 1)),
    type               TEXT    NOT NULL CHECK (type IN ('assaig', 'actuacio', 'altre')),
    category           TEXT    CHECK (category IN ('actuacio', 'taller', 'diada', 'trobada', 'assaig', 'reunio', 'termini', 'altre')),
    status             TEXT    CHECK (status IN ('planned', 'confirmed', 'done', 'cancelled')),
    published          INTEGER NOT NULL DEFAULT 0 CHECK (published IN (0, 1)),
    description        TEXT,
    image              TEXT,
    link               TEXT,
    location_latitude  REAL,
    location_longitude REAL,
    location_name      TEXT    CHECK (length(location_name) <= 200),
    address            TEXT    CHECK (length(address) <= 300),
    meeting_time       TEXT,
    meeting_point      TEXT    CHECK (length(meeting_point) <= 200),
    dress_code         TEXT    CHECK (dress_code IN ('full', 'shirt', 'casual', 'none')),
    owner_id           TEXT    REFERENCES users (id) ON DELETE SET NULL,
    attendance_open    INTEGER NOT NULL DEFAULT 0 CHECK (attendance_open IN (0, 1)),
    notes              TEXT,
    created_at         TEXT    NOT NULL,
    updated_at         TEXT    NOT NULL,
    CHECK ((location_latitude IS NULL) = (location_longitude IS NULL)),
    CHECK (published = 0 OR category IS NULL OR category NOT IN ('reunio', 'termini'))
);

CREATE INDEX events_date ON events (date);
CREATE INDEX events_published_date ON events (published, date);
CREATE INDEX events_owner_id ON events (owner_id);

-- Event.gallery (max 50 images).
CREATE TABLE event_gallery (
    event_id   TEXT    NOT NULL REFERENCES events (id) ON DELETE CASCADE,
    sort_order INTEGER NOT NULL CHECK (sort_order BETWEEN 0 AND 49),
    file       TEXT    NOT NULL,
    PRIMARY KEY (event_id, sort_order)
);

-- Event.figures
CREATE TABLE event_figures (
    event_id  TEXT NOT NULL REFERENCES events (id) ON DELETE CASCADE,
    figure_id TEXT NOT NULL REFERENCES figures (id) ON DELETE CASCADE,
    PRIMARY KEY (event_id, figure_id)
);

CREATE INDEX event_figures_figure_id ON event_figures (figure_id);

-- Event.groupIds
CREATE TABLE event_groups (
    event_id TEXT NOT NULL REFERENCES events (id) ON DELETE CASCADE,
    group_id TEXT NOT NULL REFERENCES groups (id) ON DELETE CASCADE,
    PRIMARY KEY (event_id, group_id)
);

CREATE INDEX event_groups_group_id ON event_groups (group_id);

CREATE TABLE contracts (
    id                           TEXT    NOT NULL PRIMARY KEY,
    title                        TEXT    NOT NULL CHECK (length(title) <= 200),
    type                         TEXT    NOT NULL CHECK (type IN ('dipu_catalog', 'grant', 'direct', 'exchange', 'neighbourhood_party', 'other')),
    status                       TEXT    NOT NULL CHECK (status IN ('to_contact', 'contacted', 'proposal_sent', 'negotiating', 'confirmed', 'done', 'invoiced', 'paid', 'discarded')),
    client_name                  TEXT,
    client_tax_id                TEXT,
    client_municipality          TEXT,
    client_address               TEXT,
    contact_name                 TEXT,
    contact_position             TEXT,
    contact_phone                TEXT,
    contact_email                TEXT    CHECK (contact_email = lower(contact_email)),
    contact_verified_at          TEXT,
    amount_cents                 INTEGER CHECK (amount_cents >= 0),
    vat_included                 INTEGER NOT NULL DEFAULT 0 CHECK (vat_included IN (0, 1)),
    performance_date             TEXT,
    next_action_at               TEXT,
    next_action                  TEXT    CHECK (length(next_action) <= 200),
    owner_id                     TEXT    REFERENCES users (id) ON DELETE SET NULL,
    event_id                     TEXT    UNIQUE REFERENCES events (id) ON DELETE SET NULL,
    grant_body                   TEXT,
    grant_call                   TEXT,
    grant_application_deadline   TEXT,
    grant_justification_deadline TEXT,
    grant_requested_amount_cents INTEGER CHECK (grant_requested_amount_cents >= 0),
    grant_granted_amount_cents   INTEGER CHECK (grant_granted_amount_cents >= 0),
    billing_invoice_number       TEXT,
    billing_invoiced_at          TEXT,
    billing_paid_at              TEXT,
    billing_payment_method       TEXT    CHECK (billing_payment_method IN ('transfer', 'cash', 'bizum', 'other')),
    discard_reason               TEXT,
    notes                        TEXT,
    archived                     INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1)),
    created_at                   TEXT    NOT NULL,
    updated_at                   TEXT    NOT NULL
);

CREATE INDEX contracts_updated_at ON contracts (updated_at);
CREATE INDEX contracts_status ON contracts (status);
CREATE INDEX contracts_next_action_at ON contracts (next_action_at);
CREATE INDEX contracts_owner_id ON contracts (owner_id);

CREATE TABLE inventory_items (
    id                 TEXT    NOT NULL PRIMARY KEY,
    name               TEXT    NOT NULL CHECK (length(name) <= 200),
    category           TEXT    NOT NULL CHECK (category IN ('merch', 'clothing', 'technical', 'other')),
    description        TEXT,
    image              TEXT,
    for_sale           INTEGER NOT NULL DEFAULT 0 CHECK (for_sale IN (0, 1)),
    sale_price_cents   INTEGER CHECK (sale_price_cents >= 0),
    member_price_cents INTEGER CHECK (member_price_cents >= 0),
    unit_cost_cents    INTEGER CHECK (unit_cost_cents >= 0),
    supplier           TEXT,
    condition          TEXT    CHECK (condition IN ('new', 'good', 'worn', 'broken', 'lost')),
    storage_location   TEXT    CHECK (length(storage_location) <= 200),
    owner_id           TEXT    REFERENCES users (id) ON DELETE SET NULL,
    last_counted_at    TEXT,
    notes              TEXT,
    archived           INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1)),
    created_at         TEXT    NOT NULL,
    updated_at         TEXT    NOT NULL
);

CREATE INDEX inventory_items_name ON inventory_items (name);
CREATE INDEX inventory_items_owner_id ON inventory_items (owner_id);

-- InventoryItem.variants (items without variants have a single 'única' row).
CREATE TABLE inventory_variants (
    item_id   TEXT    NOT NULL REFERENCES inventory_items (id) ON DELETE CASCADE,
    label     TEXT    NOT NULL,
    quantity  INTEGER NOT NULL DEFAULT 0 CHECK (quantity >= 0),
    min_stock INTEGER NOT NULL DEFAULT 0 CHECK (min_stock >= 0),
    PRIMARY KEY (item_id, label)
);

CREATE TABLE achievements (
    id         TEXT    NOT NULL PRIMARY KEY,
    title      TEXT    NOT NULL,
    subtitle   TEXT,
    year       INTEGER NOT NULL,
    logo       TEXT,
    group_id   TEXT    REFERENCES groups (id) ON DELETE CASCADE,
    event_id   TEXT    REFERENCES events (id) ON DELETE SET NULL,
    created_at TEXT    NOT NULL,
    updated_at TEXT    NOT NULL
);

CREATE INDEX achievements_year ON achievements (year);
CREATE INDEX achievements_group_id ON achievements (group_id);
CREATE INDEX achievements_event_id ON achievements (event_id);

CREATE TABLE documents (
    id         TEXT NOT NULL PRIMARY KEY,
    title      TEXT NOT NULL CHECK (length(title) <= 200),
    kind       TEXT NOT NULL CHECK (kind IN ('minutes', 'invoice', 'contract', 'grant', 'statutes', 'insurance', 'consent', 'other')),
    date       TEXT,
    file       TEXT NOT NULL,
    event_id   TEXT REFERENCES events (id) ON DELETE RESTRICT,
    user_id    TEXT REFERENCES users (id) ON DELETE RESTRICT,
    notes      TEXT,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL
);

CREATE INDEX documents_date ON documents (date);
CREATE INDEX documents_event_id ON documents (event_id);
CREATE INDEX documents_user_id ON documents (user_id);

CREATE TABLE attendance (
    id          TEXT NOT NULL PRIMARY KEY,
    event_id    TEXT NOT NULL REFERENCES events (id) ON DELETE CASCADE,
    user_id     TEXT NOT NULL REFERENCES users (id) ON DELETE CASCADE,
    status      TEXT NOT NULL CHECK (status IN ('yes', 'no', 'maybe', 'attended', 'absent')),
    comment     TEXT CHECK (length(comment) <= 200),
    answered_at TEXT,
    created_at  TEXT NOT NULL,
    updated_at  TEXT NOT NULL,
    UNIQUE (event_id, user_id)
);

CREATE INDEX attendance_user_id ON attendance (user_id);

